# Base URL of the Django REST API. Leave empty to run the frontend on mock data.
# Local dev example:  API_URL=http://127.0.0.1:8000
# Production example:  API_URL=https://portfolio-api-xxxx.onrender.com
API_URL=

# Public site URL, used for metadata / sitemap / OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
