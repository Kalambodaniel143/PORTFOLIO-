# Copy to .env for local development. Never commit the real .env.

# Django settings module: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

SECRET_KEY=dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Leave unset to use local SQLite (db.sqlite3).
# Neon example:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/portfolio?sslmode=require
DATABASE_URL=

# Comma-separated origins allowed to call the API (the Next.js app).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production only:
# CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app
# SECURE_SSL_REDIRECT=True
